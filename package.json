{
  "name": "@netrunner714/pegas",
  "version": "3.0.0",
  "description": "Bun-native, agent-first zero-config L7 reverse proxy orchestrator for Docker",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "pegas": "dist/index.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "bun scripts/gen-example.ts && bun scripts/gen-docs.ts && bun build src/index.ts --target=node --outfile=dist/index.js && bun build src/runtime-sdk.ts --target=node --outfile=dist/runtime.js && tsc -p tsconfig.declarations.json && mv dist/runtime-sdk.d.ts dist/runtime.d.ts && rm -rf dist/src && chmod +x dist/index.js",
    "link:global": "bun run build && bun link",
    "unlink:global": "bun unlink",
    "test": "bun scripts/test-runner.ts",
    "test:unit": "bun test --isolate --preload ./src/test-silence.ts",
    "test:full": "bun scripts/test-runner.ts",
    "test:gate": "bun scripts/check-coverage.ts",
    "test:e2e": "bun scripts/e2e.ts",
    "test:e2e:init": "bun scripts/e2e-init.ts",
    "typecheck": "tsc --noEmit",
    "docs:check": "bun scripts/docs-check.ts"
  },
  "keywords": [
    "docker",
    "caddy",
    "reverse proxy",
    "agent-native",
    "cli",
    "deployment",
    "orchestration",
    "zero-config",
    "self-hosted",
    "gateway"
  ],
  "author": "NETRUNNER714 <admin@netrunner714.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netrunner714/pegas.git"
  },
  "bugs": {
    "url": "https://github.com/netrunner714/pegas/issues"
  },
  "homepage": "https://netrunner714.ru/pegas",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime.js"
  }
}
