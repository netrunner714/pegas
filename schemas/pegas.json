{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegas.netrunner714.ru/schemas/pegas.json",
  "title": "Pegas v3 contract",
  "description": "Декларативный контракт окружения Pegas v3. Спецификация — RFC_CONTRACT_V3.md. Единственный источник правды: из этой схемы генерируются эталон (example.json), llms-контекст и reference-документация.",
  "type": "object",
  "required": [
    "projectName",
    "scenarios",
    "gateway",
    "services"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "examples": [
        "https://pegas.netrunner714.ru/schemas/pegas.json"
      ]
    },
    "projectName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Имя проекта; основа сетевых алиасов (<project>-<service>), compose-проектов и dev-доменов <project>.localhost.",
      "examples": [
        "tf2-trade-exchange",
        "netrunner714",
        "sueta"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Явный список всех сценариев проекта. Источник истины: каждая сценарная карта контракта обязана содержать все эти ключи и только их. Имена — lowercase [a-z0-9-]+, без канонизации (dev ≠ development).",
      "examples": [
        [
          "development",
          "stage",
          "production"
        ],
        [
          "development",
          "production"
        ]
      ]
    },
    "gateway": {
      "type": "object",
      "description": "Конфигурация общего шлюза по сценариям (замещает v2 devGateway).",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/gatewayScenario"
      }
    },
    "services": {
      "type": "object",
      "description": "Сервисы проекта. Ключ — имя сервиса ([a-z0-9-]+), используется в алиасах и dependsOn.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/service"
      },
      "examples": [
        {
          "redis-queue": {
            "runtime": {
              "development": {
                "driver": "docker"
              },
              "stage": {
                "driver": "docker"
              },
              "production": {
                "driver": "docker"
              }
            },
            "image": {
              "development": "redis:7-alpine",
              "stage": "redis:7-alpine",
              "production": "redis:7-alpine"
            },
            "port": {
              "development": 6379,
              "stage": 6379,
              "production": 6379
            },
            "healthcheck": {
              "development": {
                "test": [
                  "CMD",
                  "redis-cli",
                  "ping"
                ]
              },
              "stage": {
                "test": [
                  "CMD",
                  "redis-cli",
                  "ping"
                ]
              },
              "production": {
                "test": [
                  "CMD",
                  "redis-cli",
                  "ping"
                ]
              }
            },
            "secrets": [
              "REDIS_URL"
            ]
          },
          "postgres": {
            "runtime": {
              "development": {
                "driver": "docker"
              },
              "stage": {
                "driver": "docker"
              },
              "production": {
                "driver": "docker"
              }
            },
            "image": {
              "development": "postgres:18-alpine",
              "stage": "postgres:18-alpine",
              "production": "postgres:18-alpine"
            },
            "port": {
              "development": 5432,
              "stage": 5432,
              "production": 5432
            },
            "volumes": {
              "development": [
                "pgdata:/var/lib/postgresql"
              ],
              "stage": [
                "pgdata:/var/lib/postgresql"
              ],
              "production": [
                "pgdata:/var/lib/postgresql"
              ]
            },
            "healthcheck": {
              "development": {
                "test": [
                  "CMD-SHELL",
                  "pg_isready -U postgres"
                ]
              },
              "stage": {
                "test": [
                  "CMD-SHELL",
                  "pg_isready -U postgres"
                ]
              },
              "production": {
                "test": [
                  "CMD-SHELL",
                  "pg_isready -U postgres"
                ]
              }
            },
            "secrets": [
              "DATABASE_URL"
            ]
          },
          "web": {
            "runtime": {
              "development": {
                "driver": "bun"
              },
              "stage": {
                "driver": "docker"
              },
              "production": {
                "driver": "docker"
              }
            },
            "build": {
              "development": null,
              "stage": {
                "context": "."
              },
              "production": {
                "context": "."
              }
            },
            "port": {
              "development": 3000,
              "stage": 3000,
              "production": 3000
            },
            "domains": {
              "development": [
                "app.example.localhost"
              ],
              "stage": [
                "app.example.dev"
              ],
              "production": [
                "app.example.com"
              ]
            },
            "ports": {
              "development": [],
              "stage": [],
              "production": []
            },
            "dependsOn": {
              "development": null,
              "stage": {
                "redis-queue": {
                  "condition": "service_healthy"
                }
              },
              "production": {
                "redis-queue": {
                  "condition": "service_healthy"
                }
              }
            },
            "secrets": [
              "DATABASE_URL",
              "REDIS_URL",
              "SESSION_SECRET"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "scenarioMap": {
      "description": "Сценарная карта: ровно по одному значению на каждый ключ из scenarios. Полнота и точность ключей проверяет pegas check (JSON Schema не знает scenarios, поэтому структурная проверка — в валидаторе).",
      "type": "object"
    },
    "gatewayScenario": {
      "type": "object",
      "required": [
        "httpPort",
        "httpsPort"
      ],
      "additionalProperties": false,
      "properties": {
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Хостовый HTTP-порт шлюза.",
          "examples": [
            80
          ]
        },
        "httpsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Хостовый HTTPS-порт шлюза.",
          "examples": [
            443
          ]
        },
        "admin": {
          "type": "boolean",
          "description": "Включить admin-интерфейс Caddy (:2019) для сценария.",
          "examples": [
            false,
            true
          ]
        },
        "acmeEmail": {
          "type": "string",
          "format": "email",
          "description": "Email ACME/Let's Encrypt; требуется для сценариев с боевыми доменами.",
          "examples": [
            "admin@example.com"
          ]
        }
      }
    },
    "serviceRuntime": {
      "type": "object",
      "required": [
        "driver"
      ],
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string",
          "enum": [
            "docker",
            "bun"
          ],
          "description": "docker — pegas поднимает контейнер; bun — host-процесс, pegas сервис не трогает (запуск через package.json).",
          "examples": [
            "docker",
            "bun"
          ]
        }
      }
    },
    "serviceBuild": {
      "type": "object",
      "required": [
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string",
          "description": "Контекст сборки относительно корня проекта.",
          "examples": [
            "."
          ]
        },
        "dockerfile": {
          "type": "string",
          "description": "Dockerfile относительно корня проекта.",
          "examples": [
            "apps/api/Dockerfile"
          ]
        },
        "target": {
          "type": "string",
          "description": "Stage multi-target Dockerfile.",
          "examples": [
            "runner"
          ]
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Build-аргументы."
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "condition"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "string",
          "enum": [
            "service_started",
            "service_healthy"
          ],
          "description": "Условие готовности зависимости (compose-семантика).",
          "examples": [
            "service_healthy"
          ]
        }
      }
    },
    "dockerHealthcheck": {
      "type": "object",
      "required": [
        "test"
      ],
      "additionalProperties": false,
      "properties": {
        "test": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Команда healthcheck (compose-формат).",
          "examples": [
            [
              "CMD",
              "redis-cli",
              "ping"
            ]
          ]
        },
        "interval": {
          "type": "string",
          "description": "Интервал проверок.",
          "examples": [
            "10s",
            "30s"
          ]
        },
        "timeout": {
          "type": "string",
          "description": "Таймаут проверки.",
          "examples": [
            "3s",
            "5s"
          ]
        },
        "retries": {
          "type": "integer",
          "minimum": 1,
          "description": "Число ретраев до unhealthy.",
          "examples": [
            3,
            5
          ]
        },
        "startPeriod": {
          "type": "string",
          "description": "Отсрочка учёта падений на старте.",
          "examples": [
            "30s"
          ]
        }
      }
    },
    "serviceHealthcheck": {
      "description": "docker-сервис — объект compose-healthcheck; bun-сервис — строка HTTP ping-URL (информативна, pegas не опрашивает); null — healthcheck нет.",
      "oneOf": [
        {
          "$ref": "#/$defs/dockerHealthcheck"
        },
        {
          "type": "string",
          "format": "uri",
          "examples": [
            "http://localhost:3000/api/health"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "sharedTenant": {
      "description": "Параметры аренды в разделяемом пуле (issue #29): имя базы и роли (postgres) или префикс ключей (redis); secret — имя ключа из .env, объявленного также в services.<name>.secrets.",
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "examples": [
            "alpha_db"
          ]
        },
        "secret": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$",
          "examples": [
            "DATABASE_PASSWORD"
          ]
        }
      }
    },
    "serviceBackup": {
      "description": "Политика автоматического бэкапа PostgreSQL: Pegas добавляет в compose сайдкар с pg_dump и named-volume. Значения подключения — из env сервиса (POSTGRES_USER/POSTGRES_DB), пароль — из секрета passwordSecret.",
      "type": "object",
      "required": [
        "every",
        "keep"
      ],
      "additionalProperties": false,
      "properties": {
        "every": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[mhd]$",
          "description": "Интервал между дампами: 30m, 1h, 7d (минимум 1 минута).",
          "examples": [
            "1h"
          ]
        },
        "keep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Сколько последних дампов хранить; после успешного нового старые удаляются.",
          "examples": [
            24
          ]
        },
        "user": {
          "type": "string",
          "description": "Пользователь БД; по умолчанию POSTGRES_USER из env сервиса.",
          "examples": [
            "postgres"
          ]
        },
        "database": {
          "type": "string",
          "description": "Имя БД; по умолчанию POSTGRES_DB из env сервиса.",
          "examples": [
            "app"
          ]
        },
        "passwordSecret": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$",
          "description": "Имя секрета с паролем; по умолчанию POSTGRES_PASSWORD. Секрет обязан быть в services.<name>.secrets.",
          "examples": [
            "POSTGRES_PASSWORD"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "runtime"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "object",
          "description": "Драйвер по сценариям.",
          "additionalProperties": {
            "$ref": "#/$defs/serviceRuntime"
          }
        },
        "image": {
          "type": "object",
          "description": "Docker-образ по сценариям; обязателен для docker-сервисов без build.",
          "additionalProperties": {
            "type": "string",
            "examples": [
              "redis:7-alpine",
              "postgres:18-alpine"
            ]
          }
        },
        "build": {
          "type": "object",
          "description": "Сборка по сценариям; null в сценариях host-драйвера.",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/serviceBuild"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "command": {
          "type": "object",
          "description": "Команда процесса в контейнере по сценариям.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "redis-server",
                "--appendonly",
                "yes"
              ]
            ]
          }
        },
        "port": {
          "type": "object",
          "description": "Логический TCP-порт по сценариям; обязателен при domains.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "examples": [
              3000,
              6379
            ]
          }
        },
        "ports": {
          "type": "object",
          "description": "Проброс портов на хост по сценариям; [] вне development — норма (закрытый сервис). Непустой вне dev требует publicHost.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+:[0-9]+$"
            },
            "examples": [
              [
                "6379:6379"
              ],
              []
            ]
          }
        },
        "domains": {
          "type": "object",
          "description": "HTTP-домены шлюза по сценариям; строго для HTTP-сервисов (при host-драйвере сценария — error).",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "api.example.com"
              ],
              [
                "web.my-app.localhost"
              ]
            ]
          }
        },
        "publicHost": {
          "type": "object",
          "description": "Публичное DNS-имя TCP-сервиса по сценариям; Caddy не маршрутизирует, TLS — ответственность контейнера.",
          "additionalProperties": {
            "type": "string",
            "examples": [
              "pg18.example.com"
            ]
          }
        },
        "volumes": {
          "type": "object",
          "description": "Named-тома по сценариям (compose short syntax). Для образов postgres:18+ точка монтирования — /var/lib/postgresql (не /var/lib/postgresql/data): с 18-й версии данные хранятся в каталогах по мажорным версиям, монтирование в .../data приводит к рестарт-лупу контейнера.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "pgdata:/var/lib/postgresql"
              ]
            ]
          }
        },
        "dependsOn": {
          "type": "object",
          "description": "Зависимости по сценариям; при host-драйвере сценария допустим только пустой объект.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/dependency"
            }
          }
        },
        "healthcheck": {
          "type": "object",
          "description": "Healthcheck по сценариям.",
          "additionalProperties": {
            "$ref": "#/$defs/serviceHealthcheck"
          }
        },
        "networkAliases": {
          "type": "object",
          "description": "Дополнительные DNS-имена сервиса в общей сети pegas-network по сценариям. Нужны инфраструктурным сервисам, к которым обращаются соседние проекты: scoped-алиас зависит от абсолютного пути проекта. Имя — DNS-метка, уникальная в сценарии; недоступно host-сервисам.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "examples": [
              [
                "egress-proxy"
              ]
            ]
          }
        },
        "env": {
          "type": "object",
          "description": "Несекретные значения конфигурации (Zero Scalars: карта сценариев на каждый ключ). Специальный формат значения: \"pegas://<имя-сервиса>\" — service discovery: pegas подставляет внутренний адрес сервиса в сети pegas-network (scheme по образу: redis -> redis, postgres -> postgresql, иначе http).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "examples": [
                "pretty",
                "json"
              ]
            }
          }
        },
        "cors": {
          "type": "object",
          "description": "CORS-заголовки по сценариям.",
          "additionalProperties": {
            "type": "boolean",
            "examples": [
              true,
              false
            ]
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "description": "Имена секретных ключей сервиса (интерфейс зависимостей). Значения — из .env (dev) / CI (prod). Замещает v2 envFile и корневые secrets.",
          "examples": [
            [
              "DATABASE_URL",
              "REDIS_URL"
            ],
            [
              "SESSION_SECRET"
            ]
          ]
        },
        "scope": {
          "type": "object",
          "description": "Область жизненного цикла по сценариям (issue #29): isolated — собственный контейнер проекта (по умолчанию); shared — аренда в общем инфраструктурном пуле Pegas. Shared допустим только для поддерживаемых образов (postgres, redis и производные), без build, volumes и dependsOn.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "isolated",
              "shared"
            ]
          }
        },
        "shared": {
          "type": "object",
          "description": "Параметры аренды в разделяемом пуле по сценариям (issue #29); объект обязателен в сценариях со scope: \"shared\", в остальных — null.",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/sharedTenant"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "backup": {
          "type": "object",
          "description": "Автобэкап PostgreSQL по сценариям: { every: \"1h\", keep: 24 } или null (выключено). Pegas сам добавляет сайдкар с pg_dump и named-volume; cron на хосте не нужен.",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/serviceBackup"
              },
              {
                "type": "null"
              }
            ]
          },
          "examples": [
            {
              "development": null,
              "stage": {
                "every": "1h",
                "keep": 24
              },
              "production": {
                "every": "1h",
                "keep": 24
              }
            }
          ]
        }
      },
      "examples": [
        {
          "runtime": {
            "development": {
              "driver": "docker"
            },
            "stage": {
              "driver": "docker"
            },
            "production": {
              "driver": "docker"
            }
          },
          "image": {
            "development": "redis:7-alpine",
            "stage": "redis:7-alpine",
            "production": "redis:7-alpine"
          },
          "port": {
            "development": 6379,
            "stage": 6379,
            "production": 6379
          },
          "healthcheck": {
            "development": {
              "test": [
                "CMD",
                "redis-cli",
                "ping"
              ]
            },
            "stage": {
              "test": [
                "CMD",
                "redis-cli",
                "ping"
              ]
            },
            "production": {
              "test": [
                "CMD",
                "redis-cli",
                "ping"
              ]
            }
          },
          "secrets": [
            "REDIS_URL"
          ]
        },
        {
          "runtime": {
            "development": {
              "driver": "docker"
            },
            "stage": {
              "driver": "docker"
            },
            "production": {
              "driver": "docker"
            }
          },
          "image": {
            "development": "postgres:18-alpine",
            "stage": "postgres:18-alpine",
            "production": "postgres:18-alpine"
          },
          "port": {
            "development": 5432,
            "stage": 5432,
            "production": 5432
          },
          "volumes": {
            "development": [
              "pgdata:/var/lib/postgresql"
            ],
            "stage": [
              "pgdata:/var/lib/postgresql"
            ],
            "production": [
              "pgdata:/var/lib/postgresql"
            ]
          },
          "healthcheck": {
            "development": {
              "test": [
                "CMD-SHELL",
                "pg_isready -U postgres"
              ]
            },
            "stage": {
              "test": [
                "CMD-SHELL",
                "pg_isready -U postgres"
              ]
            },
            "production": {
              "test": [
